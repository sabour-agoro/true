# Virtual try-on. Leave empty to use the on-device demo composite.
# The photo is processed in memory and never written to disk.
TRYON_API_KEY=
TRYON_API_URL=https://api.fashn.ai/v1
# tryon-max (product_image) or tryon-v1.6 (garment_image)
TRYON_MODEL=tryon-max

# Optional webhook for the contact form (POST JSON { name, email, message }).
CONTACT_WEBHOOK=

# Stripe Checkout. Use test keys (sk_test_...) until the shop is live.
# XOF has no cents: 10000 means 10 000 F CFA.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public site origin used for the return URL. Optional in local dev.
NEXT_PUBLIC_SITE_URL=

# FedaPay. Live keys start with sk_live_ / pk_live_. Sandbox uses sk_sandbox_ and FEDAPAY_ENVIRONMENT=sandbox.
FEDAPAY_SECRET_KEY=
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY=
FEDAPAY_ENVIRONMENT=live
# Secret du webhook FedaPay (Workbench → Webhooks). Différent de la clé API.
FEDAPAY_WEBHOOK_SECRET=
# Stockage des passes. Créé par Vercel Blob, ne pas commiter.
BLOB_READ_WRITE_TOKEN=

# Emails du pass (client + notification au propriétaire). Gmail : mot de passe d'application, pas le mot de passe du compte.
ORDER_NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
